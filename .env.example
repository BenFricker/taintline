# taintline settings: copy to .env and fill in. Never commit .env.
# Everything runs locally by default; no API keys are needed.

# Logging level: DEBUG, INFO, WARNING, ERROR
TAINTLINE_LOG_LEVEL=INFO

# Local model runtime (decided in Stage 0; placeholders until then)
TAINTLINE_MODEL_BACKEND=ollama
TAINTLINE_MODEL_HOST=http://127.0.0.1:11434
TAINTLINE_MODEL_NAME=

# Optional cloud backend: OFF by default. Leave blank unless explicitly enabled.
# TAINTLINE_ALLOW_REMOTE_MODEL=false
# TAINTLINE_REMOTE_API_KEY=
